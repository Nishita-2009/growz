# FastAPI Backend Configuration
PROJECT_NAME="Growz"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="growz_user"
POSTGRES_PASSWORD=
POSTGRES_DB="growz_db"

# SQLite Fallback (Optional for local dev without PostgreSQL)
USE_SQLITE=True
SQLITE_DB_FILE="growz.db"

# Redis Cache Settings
REDIS_HOST="localhost"
REDIS_PORT=6379

# Firebase Admin Service Account Credentials (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

# Google Gemini AI Key
GEMINI_API_KEY=
GEMINI_MODEL="gemini-1.5-pro"
